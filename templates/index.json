    "why_it_works": {
      "type": "multicolumn",
      "blocks": {
        "sensor": {
          "type": "column",
          "settings": {
            "title": "Motion sensor with adjustable delay",
            "text": "<p>An infrared sensor turns the light on when someone moves in front of it and off again after a set delay. Hallways and closets are lit only while you are actually there.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "mount": {
          "type": "column",
          "settings": {
            "title": "Magnetic mount, no drilling",
            "text": "<p>A slim metal plate sticks to the surface; the light snaps onto it magnetically. Pull it off to charge, snap it back when it is done. No screws, no wiring, no electrician.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "colour": {
          "type": "column",
          "settings": {
            "title": "Three colour temperatures",
            "text": "<p>Warm, neutral or cool white. Warm for a hallway at night, neutral under kitchen cabinets, cool inside a wardrobe where you need to see true colours.</p>",
            "link_label": "",
            "link": ""
          }
        }
      },
