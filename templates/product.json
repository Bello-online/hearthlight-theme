      "blocks": {
        "hallway": {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "title": "Hallway at 2 a.m.",
            "quote": "<p>Mounted the 30 cm bar low on the wall between our bedroom and the bathroom. It comes on at ankle height when you walk past and shuts off a few seconds after you are gone. On the warm setting it is dim enough that nobody fully wakes up.</p>",
            "author": "Priya S., Mississauga",
            "verified": false
          }
        },
        "kitchen": {
          "type": "testimonial",
          "settings": {
            "rating": 4,
            "title": "Under-cabinet, finally",
            "quote": "<p>Two 40 cm bars under the upper cabinets above the counter. Neutral white is the right call for cooking. Charging every few weeks is fine because the magnet mount makes taking them down a two-second job. I would have liked a longer cable.</p>",
            "author": "Marc D., Gatineau",
            "verified": false
          }
        },
        "wardrobe": {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "title": "Wardrobe with no outlet",
            "quote": "<p>Our closet has no light and no outlet nearby, so wiring was never going to happen. The 20 cm bar on the underside of the top shelf lights the whole rail when the door opens. Mounting took about a minute.</p>",
            "author": "Alison T., Victoria",
            "verified": false
          }
        }
      },
