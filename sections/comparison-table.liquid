{{ 'cro.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  }
{%- endstyle -%}
{%- assign us_label = section.settings.us_label | default: shop.name -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width page-width--narrow section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <div class="comparison__header center">
        <h2 class="comparison__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}<div class="comparison__subheading rte">{{ section.settings.subheading }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="comparison__table-wrapper">
      <table class="comparison__table">
        <thead>
          <tr>
            <th scope="col" class="comparison__feature-head"><span class="visually-hidden">Feature</span></th>
            <th scope="col" class="comparison__us-head">{{ us_label | escape }}</th>
            <th scope="col" class="comparison__them-head">{{ section.settings.them_label | escape }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row" class="comparison__feature">{{ block.settings.feature | escape }}</th>
              <td class="comparison__cell comparison__cell--us">
                {%- if block.settings.us_text != blank -%}{{ block.settings.us_text | escape }}
                {%- elsif block.settings.us -%}<span class="comparison__yes">{% render 'icon-accordion', icon: 'check_mark' %}<span class="visually-hidden">Yes</span></span>
                {%- else -%}<span class="comparison__no" aria-hidden="true">&mdash;</span><span class="visually-hidden">No</span>{%- endif -%}
              </td>
              <td class="comparison__cell comparison__cell--them">
                {%- if block.settings.them_text != blank -%}{{ block.settings.them_text | escape }}
                {%- elsif block.settings.them -%}<span class="comparison__yes comparison__yes--muted">{% render 'icon-accordion', icon: 'check_mark' %}<span class="visually-hidden">Yes</span></span>
                {%- else -%}<span class="comparison__no" aria-hidden="true">&mdash;</span><span class="visually-hidden">No</span>{%- endif -%}
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- if section.settings.button_label != blank -%}
      <div class="center comparison__cta"><a href="{{ section.settings.button_link | default: '/collections/all' }}" class="button">{{ section.settings.button_label | escape }}</a></div>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Comparison table",
  "tag": "section",
  "class": "section section-comparison",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why people switch" },
    { "type": "select", "id": "heading_size", "label": "t:sections.all.heading_size.label", "default": "h1", "options": [ { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" }, { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" }, { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" } ] },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "us_label", "label": "Our column label", "info": "Leave blank to use the store name" },
    { "type": "text", "id": "them_label", "label": "Their column label", "default": "Typical alternative" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 48 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Free shipping" },
        { "type": "checkbox", "id": "us", "label": "We have it", "default": true },
        { "type": "text", "id": "us_text", "label": "Our value (optional text instead of a check)" },
        { "type": "checkbox", "id": "them", "label": "They have it", "default": false },
        { "type": "text", "id": "them_text", "label": "Their value (optional text instead of a check)" }
      ]
    }
  ],
  "presets": [ { "name": "Comparison table", "blocks": [ { "type": "row" }, { "type": "row", "settings": { "feature": "30-day returns" } }, { "type": "row", "settings": { "feature": "Real customer support" } } ] } ]
}
{% endschema %}
