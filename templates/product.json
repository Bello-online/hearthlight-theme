        "shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & returns",
            "icon": "truck",
            "content": "<p>Free shipping on orders over $75, applied at checkout. Most orders arrive in 8–15 business days; the estimate at checkout is the real one. You get a tracking number by email as soon as the order ships.</p><p>Return unused items in their original packaging within 30 days of delivery for a refund. If a light develops a fault within 12 months, we replace it. Start either one from the <a href=\"/pages/contact\" title=\"Contact\">Contact</a> page with your order number.</p>"
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
