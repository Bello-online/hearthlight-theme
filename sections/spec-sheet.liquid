{{ 'section-spec-sheet.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign has_blocks = false
  if section.blocks.size > 0
    assign has_blocks = true
  endif
  assign specs_metafield = product.metafields.custom.specs
-%}

<div class="spec-sheet color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="spec-sheet__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="spec-sheet__heading h2" id="SpecSheet-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="spec-sheet__intro rte">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if has_blocks -%}
      <dl class="spec-sheet__grid spec-sheet__grid--{{ section.settings.columns }}" aria-labelledby="SpecSheet-{{ section.id }}">
        {%- for block in section.blocks -%}
          <div class="spec-sheet__card" {{ block.shopify_attributes }}>
            <span class="spec-sheet__icon" aria-hidden="true">{% render 'icon-hearthlight', icon: block.settings.icon %}</span>
            <dt class="spec-sheet__label">{{ block.settings.label | escape }}</dt>
            <dd class="spec-sheet__value">
              <span class="spec-sheet__figure">{{ block.settings.value | escape }}</span>
              {%- if block.settings.note != blank -%}
                <span class="spec-sheet__note">{{ block.settings.note | escape }}</span>
              {%- endif -%}
            </dd>
          </div>
        {%- endfor -%}
      </dl>
    {%- elsif specs_metafield != blank -%}
      <div class="spec-sheet__metafield rte">
        {{ specs_metafield | metafield_tag }}
      </div>
    {%- endif -%}

    {%- if section.settings.show_in_the_box and section.settings.in_the_box != blank -%}
      <aside class="spec-sheet__box" aria-labelledby="SpecSheetBox-{{ section.id }}">
        <h3 class="spec-sheet__box-heading h4" id="SpecSheetBox-{{ section.id }}">
          {{ section.settings.in_the_box_heading | default: "What's in the box" | escape }}
        </h3>
        <div class="spec-sheet__box-list rte">{{ section.settings.in_the_box }}</div>
      </aside>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Spec sheet",
  "tag": "section",
  "class": "section section-spec-sheet",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Specifications"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "info": "Optional. One or two sentences under the heading."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 3,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "paragraph",
      "content": "With no spec blocks, the section renders the product's custom.specs rich text metafield if it exists."
    },
    {
      "type": "header",
      "content": "In the box"
    },
    {
      "type": "checkbox",
      "id": "show_in_the_box",
      "label": "Show \"In the box\" panel",
      "default": true
    },
    {
      "type": "text",
      "id": "in_the_box_heading",
      "label": "Panel heading",
      "default": "What's in the box"
    },
    {
      "type": "richtext",
      "id": "in_the_box",
      "label": "Contents",
      "info": "Use a bulleted list; each item gets a check mark.",
      "default": "<ul><li>Light bar</li><li>Magnetic mounting strip</li><li>USB-C charging cable</li><li>Quick-start guide</li></ul>"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "bolt", "label": "Bolt" },
            { "value": "sensor", "label": "Sensor" },
            { "value": "magnet", "label": "Magnet" },
            { "value": "palette", "label": "Palette" },
            { "value": "battery", "label": "Battery" },
            { "value": "usb", "label": "USB-C" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "clock", "label": "Clock" },
            { "value": "weight", "label": "Weight" },
            { "value": "shield", "label": "Shield" }
          ],
          "default": "bolt"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Battery"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "2000 mAh"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note",
          "info": "Optional. Shown in muted text under the value."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Spec sheet",
      "blocks": [
        { "type": "spec", "settings": { "icon": "battery", "label": "Battery", "value": "[2000 mAh]" } },
        { "type": "spec", "settings": { "icon": "usb", "label": "Charge time", "value": "[~2 h]", "note": "USB-C" } },
        { "type": "spec", "settings": { "icon": "sensor", "label": "Sensor range", "value": "[3 m / 120°]" } },
        { "type": "spec", "settings": { "icon": "palette", "label": "Brightness", "value": "[3 colour temperatures]" } },
        { "type": "spec", "settings": { "icon": "ruler", "label": "Length", "value": "[10 / 20 / 30 / 40 cm]" } },
        { "type": "spec", "settings": { "icon": "magnet", "label": "Mount", "value": "[Magnetic, tool-free]" } }
      ]
    }
  ]
}
{% endschema %}
