{%- comment -%} Free-shipping progress bar. Uses settings.free_shipping_threshold (whole currency units). {%- endcomment -%}
{%- if settings.free_shipping_enabled and settings.free_shipping_threshold > 0 -%}
  {%- assign threshold = settings.free_shipping_threshold | times: 100 -%}
  {%- assign total = cart.total_price -%}
  {%- assign remaining = threshold | minus: total -%}
  {%- assign progress = total | times: 100 | divided_by: threshold -%}
  {%- if progress > 100 -%}{%- assign progress = 100 -%}{%- endif -%}
  <div class="free-shipping-bar" role="status" aria-live="polite">
    <p class="free-shipping-bar__text">
      {%- if remaining > 0 -%}
        {%- assign remaining_money = remaining | money -%}
        {{ settings.free_shipping_text_remaining | replace: '[amount]', remaining_money }}
      {%- else -%}
        {{ settings.free_shipping_text_unlocked }}
      {%- endif -%}
    </p>
    <div class="free-shipping-bar__track"><span class="free-shipping-bar__fill" style="width: {{ progress }}%"></span></div>
  </div>
{%- endif -%}
