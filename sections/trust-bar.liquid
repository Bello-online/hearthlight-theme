{{ 'cro.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  }
{%- endstyle -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <ul class="trust-bar trust-bar--{{ section.blocks.size }} list-unstyled" role="list">
      {%- for block in section.blocks -%}
        <li class="trust-bar__item" {{ block.shopify_attributes }}>
          <span class="trust-bar__icon" aria-hidden="true">{% render 'icon-accordion', icon: block.settings.icon %}</span>
          <div class="trust-bar__text">
            {%- if block.settings.heading != blank -%}<strong class="trust-bar__heading h5">{{ block.settings.heading | escape }}</strong>{%- endif -%}
            {%- if block.settings.text != blank -%}<span class="trust-bar__copy">{{ block.settings.text | escape }}</span>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>
{% schema %}
{
  "name": "Trust bar",
  "tag": "section",
  "class": "section section-trust-bar",
  "max_blocks": 6,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 24 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
          { "value": "truck", "label": "Truck" }, { "value": "return", "label": "Return" }, { "value": "lock", "label": "Lock" },
          { "value": "check_mark", "label": "Check mark" }, { "value": "heart", "label": "Heart" }, { "value": "star", "label": "Star" },
          { "value": "leaf", "label": "Leaf" }, { "value": "box", "label": "Box" }, { "value": "chat_bubble", "label": "Chat" },
          { "value": "price_tag", "label": "Price tag" }, { "value": "stopwatch", "label": "Stopwatch" }, { "value": "plane", "label": "Plane" },
          { "value": "ruler", "label": "Ruler" }, { "value": "padlock", "label": "Padlock" }, { "value": "discount", "label": "Discount" },
          { "value": "map_pin", "label": "Map pin" }, { "value": "question_mark", "label": "Question mark" }, { "value": "lightning_bolt", "label": "Lightning" }
        ] },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Free shipping" },
        { "type": "text", "id": "text", "label": "Text", "default": "On orders over $60" }
      ]
    }
  ],
  "presets": [
    { "name": "Trust bar", "blocks": [
      { "type": "item", "settings": { "icon": "truck", "heading": "Free shipping", "text": "On orders over $60" } },
      { "type": "item", "settings": { "icon": "return", "heading": "30-day returns", "text": "No questions asked" } },
      { "type": "item", "settings": { "icon": "lock", "heading": "Secure checkout", "text": "Shop Pay, Apple Pay, PayPal" } },
      { "type": "item", "settings": { "icon": "chat_bubble", "heading": "Real support", "text": "Replies within one business day" } }
    ] }
  ]
}
{% endschema %}
